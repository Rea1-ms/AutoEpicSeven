{
  "card-DevicePage-ConnectionTarget": {
    "_info": {"group": "ConnectionTarget", "arg": "_info", "card": "card-DevicePage-ConnectionTarget"},
    "Emulator": {
      "Serial": {
        "task": "Device",
        "group": "Emulator",
        "arg": "Serial",
        "dt": "input",
        "value": "auto"
      }
    },
    "EmulatorInfo": {
      "Emulator": {
        "task": "Device",
        "group": "EmulatorInfo",
        "arg": "Emulator",
        "dt": "select",
        "value": "auto",
        "option": ["auto", "NoxPlayer", "NoxPlayer64", "BlueStacks4", "BlueStacks5", "BlueStacks4HyperV", "BlueStacks5HyperV", "LDPlayer3", "LDPlayer4", "LDPlayer9", "MuMuPlayer", "MuMuPlayerX", "MuMuPlayer12", "MEmuPlayer"]
      },
      "Name": {
        "task": "Device",
        "group": "EmulatorInfo",
        "arg": "Name",
        "dt": "textarea",
        "value": "",
        "layout": "vert"
      },
      "Path": {
        "task": "Device",
        "group": "EmulatorInfo",
        "arg": "Path",
        "dt": "textarea",
        "value": "",
        "layout": "vert"
      }
    },
    "Game": {
      "PackageName": {
        "task": "Alas",
        "group": "Game",
        "arg": "PackageName",
        "dt": "select",
        "value": "auto",
        "option": ["auto", "CN-Official", "OVERSEA-Play"]
      },
      "GameClient": {
        "task": "Alas",
        "group": "Game",
        "arg": "GameClient",
        "dt": "select",
        "value": "android",
        "option": ["android", "cloud_android"]
      }
    }
  },
  "card-DevicePage-ScreenshotControl": {
    "_info": {"group": "ScreenshotControl", "arg": "_info", "card": "card-DevicePage-ScreenshotControl"},
    "Emulator": {
      "ScreenshotMethod": {
        "task": "Device",
        "group": "Emulator",
        "arg": "ScreenshotMethod",
        "dt": "select",
        "value": "auto",
        "option": ["auto", "ADB", "ADB_nc", "uiautomator2", "aScreenCap", "aScreenCap_nc", "DroidCast", "DroidCast_raw", "scrcpy", "nemu_ipc", "ldopengl"]
      },
      "ControlMethod": {
        "task": "Device",
        "group": "Emulator",
        "arg": "ControlMethod",
        "dt": "select",
        "value": "MaaTouch",
        "option": ["ADB", "uiautomator2", "minitouch", "Hermit", "MaaTouch"]
      },
      "ScreenshotDedithering": {
        "task": "Device",
        "group": "Emulator",
        "arg": "ScreenshotDedithering",
        "dt": "checkbox",
        "value": false
      }
    }
  },
  "card-DevicePage-Recovery": {
    "_info": {"group": "Recovery", "arg": "_info", "card": "card-DevicePage-Recovery"},
    "Emulator": {
      "AdbRestart": {
        "task": "Device",
        "group": "Emulator",
        "arg": "AdbRestart",
        "dt": "checkbox",
        "value": false
      }
    },
    "Error": {
      "HandleError": {
        "task": "Device",
        "group": "Error",
        "arg": "HandleError",
        "dt": "checkbox",
        "value": true
      },
      "SaveError": {
        "task": "Device",
        "group": "Error",
        "arg": "SaveError",
        "dt": "checkbox",
        "value": true
      },
      "ScreenshotLength": {
        "task": "Device",
        "group": "Error",
        "arg": "ScreenshotLength",
        "dt": "input-int",
        "value": 1
      }
    }
  },
  "card-DevicePage-RuntimeOptimization": {
    "_info": {"group": "RuntimeOptimization", "arg": "_info", "card": "card-DevicePage-RuntimeOptimization"},
    "Optimization": {
      "ScreenshotInterval": {
        "task": "Device",
        "group": "Optimization",
        "arg": "ScreenshotInterval",
        "dt": "input-float",
        "value": 0.3
      },
      "CombatScreenshotInterval": {
        "task": "Device",
        "group": "Optimization",
        "arg": "CombatScreenshotInterval",
        "dt": "input-float",
        "value": 1.0
      },
      "TaskHoardingDuration": {
        "task": "Device",
        "group": "Optimization",
        "arg": "TaskHoardingDuration",
        "dt": "input-int",
        "value": 0
      },
      "WhenTaskQueueEmpty": {
        "task": "Device",
        "group": "Optimization",
        "arg": "WhenTaskQueueEmpty",
        "dt": "select",
        "value": "goto_main",
        "option": ["stay_there", "goto_main", "stop_game", "stop_device"]
      }
    }
  }
}